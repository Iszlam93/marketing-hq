# Copy to .env.local for local runs (optional). On Vercel, set these in Project Settings -> Environment Variables.
# Without GITHUB_TOKEN the app reads/writes the local repo checkout instead (local mode).
GITHUB_TOKEN=github_pat_...        # fine-grained token: repo Iszlam93/marketing-hq, Contents: Read and write
GITHUB_REPO=Iszlam93/marketing-hq
GITHUB_BRANCH=main
APP_PASSWORD=choose-a-strong-password
TELEGRAM_BOT_TOKEN=                 # optional: confirms app actions in Telegram
TELEGRAM_CHAT_ID=
